--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Interfacer = require(ReplicatedStorage:WaitForChild("Flux")) :: any
local Assertions = require(ReplicatedStorage:WaitForChild("sert")) :: any

Assertions.rtest("native lifecycle · disposal during ChildAdded completes destruction", function()
	local Container = Instance.new("Folder")
	local Owner = Interfacer.Scope(function() end)
	local Target : Instance? = nil
	local Releases = 0
	Interfacer.WithOwner(Owner, function()
		Interfacer.Cleanup(function()
			Releases += 1
		end)
	end)
	local Connection = Container.ChildAdded:Connect(function(Child)
		Target = Child
		Owner:Destroy()
	end)
	Interfacer.WithOwner(Owner, function()
		Interfacer.New("TextLabel")({ Text = "settled", Parent = Container })
	end)
	task.wait()
	Connection:Disconnect()
	local Detached = Target ~= nil and Target.Parent == nil
	Container:Destroy()
	Assertions(Detached, "a disposed child must not remain attached after Parent returns")
	Assertions(Releases == 1, "cleanup completes exactly once")
end)

Assertions.rtest("native lifecycle · replacement permanently disconnects the previous source", function()
	local First = Interfacer.State("first")
	local Second = Interfacer.State("second")
	local Label = Instance.new("TextLabel")
	local Owner = Interfacer.Scope(function()
		Interfacer.Edit(Label)({ Text = First })
		Interfacer.Edit(Label)({ Text = Second })
	end)
	Interfacer.Flush()
	First:Set("stale")
	Interfacer.Flush()
	local Actual = Label.Text
	Owner:Destroy()
	Label:Destroy()
	First:Destroy()
	Second:Destroy()
	Assertions(Actual == "second", "a superseded source must never write again")
end)

Assertions.rtest("native lifecycle · replacement during initial assignment wins", function()
	local First = Interfacer.State("first")
	local Second = Interfacer.State("replacement")
	local Label = Instance.new("TextLabel")
	local Owner = Interfacer.Scope(function() end)
	local Replaced = false
	local Connection = Label:GetPropertyChangedSignal("Text"):Connect(function()
		if not Replaced then
			Replaced = true
			Interfacer.WithOwner(Owner, function()
				Interfacer.Edit(Label)({ Text = Second })
			end)
		end
	end)
	Interfacer.WithOwner(Owner, function()
		Interfacer.Edit(Label)({ Text = First })
	end)
	task.wait()
	Interfacer.Flush()
	First:Set("stale")
	Interfacer.Flush()
	local Actual = Label.Text
	Connection:Disconnect()
	Owner:Destroy()
	Label:Destroy()
	First:Destroy()
	Second:Destroy()
	Assertions(Replaced and Actual == "replacement", "the returning initial write must not restore its old registration")
end)

Assertions.rtest("native lifecycle · initial properties settle before parenting", function()
	local Container = Instance.new("Folder")
	local Observed = ""
	local Connection = Container.ChildAdded:Connect(function(Child)
		Observed = (Child :: TextLabel).Text
	end)
	local Source = Interfacer.State("ready")
	local Owner = Interfacer.Scope(function()
		Interfacer.New("TextLabel")({ Text = Source, Parent = Container })
	end)
	task.wait()
	Owner:Destroy()
	Connection:Disconnect()
	Container:Destroy()
	Source:Destroy()
	Assertions(Observed == "ready", "ChildAdded sees the initialized text")
end)

Assertions.rtest("native lifecycle · literal replacement unbinds reactive properties and attributes", function()
	local Source = Interfacer.State("reactive")
	local Label = Instance.new("TextLabel")
	local Owner = Interfacer.Scope(function()
		Interfacer.Edit(Label)({ Text = Source, __ATTR = { Status = Source } })
		Interfacer.Edit(Label)({ Text = "literal", __ATTR = { Status = "literal" } })
	end)
	Source:Set("stale")
	Interfacer.Flush()
	local Text, Attribute = Label.Text, Label:GetAttribute("Status")
	Owner:Destroy()
	Label:Destroy()
	Source:Destroy()
	Assertions(Text == "literal" and Attribute == "literal", "literal assignments revoke both old registrations")
end)

Assertions.rtest("native lifecycle · disposing one editing owner preserves other properties", function()
	local Label = Instance.new("TextLabel")
	local Source = Interfacer.State("text")
	local Visibility = Interfacer.State(true)
	local FirstOwner = Interfacer.Scope(function()
		Interfacer.Edit(Label)({ Text = Source })
	end)
	local SecondOwner = Interfacer.Scope(function()
		Interfacer.Edit(Label)({ Visible = Visibility })
	end)
	FirstOwner:Destroy()
	Source:Set("stale")
	Visibility:Set(false)
	Interfacer.Flush()
	local Text, Visible = Label.Text, Label.Visible
	SecondOwner:Destroy()
	Label:Destroy()
	Source:Destroy()
	Visibility:Destroy()
	Assertions(Text == "text" and not Visible, "scope cleanup revokes only its own resources")
end)

Assertions.rtest("native lifecycle · external destruction cancels queued bindings", function()
	local Source = Interfacer.State("first")
	local Label : TextLabel
	local Destroyed = 0
	local Owner = Interfacer.Scope(function()
		Label = Interfacer.New("TextLabel")({ Text = Source })
	end)
	local Connection = Label.Destroying:Connect(function()
		Destroyed += 1
	end)
	Source:Set("queued")
	Label:Destroy()
	task.wait()
	Interfacer.Flush()
	local Text = Label.Text
	Owner:Destroy()
	Owner:Destroy()
	Connection:Disconnect()
	Source:Destroy()
	Assertions(Text == "first", "queued work cannot write to an externally destroyed target")
	Assertions(Destroyed == 1, "native destruction runs exactly once")
end)

Assertions.rtest("native lifecycle · constructor failure releases bindings and preserves the Parent error", function()
	local Source = Interfacer.State("initial")
	local Captured : TextLabel? = nil
	local Cleanups = 0
	local Owner = Interfacer.Scope(function() end)
	local Passed, Failure = pcall(function()
		Interfacer.WithOwner(Owner, function()
			Interfacer.New("TextLabel")({
				Text = Source,
				__REF = function(Target : TextLabel)
					Captured = Target
				end,
				__CLEAN = { function()
					Cleanups += 1
					error("cleanup-secondary")
				end },
				Parent = "invalid-parent",
			})
		end)
	end)
	Source:Set("must-not-publish")
	Interfacer.Flush()
	Owner:Destroy()
	local Target = Captured
	Assertions(not Passed and not string.find(tostring(Failure), "cleanup-secondary", 1, true), "original assignment error wins")
	Assertions(Target ~= nil and Target.Text == "initial" and Target.Parent == nil, "failed construction releases its publication registrations")
	Assertions(Cleanups == 1, "throwing cleanup runs once")
	Source:Destroy()
end)

Assertions.rtest("native lifecycle · reactive Parent disposal completes its active write", function()
	local FirstContainer = Instance.new("Folder")
	local SecondContainer = Instance.new("Folder")
	local ParentSource = Interfacer.State(FirstContainer)
	local Target : TextLabel
	local Owner = Interfacer.Scope(function()
		Target = Interfacer.New("TextLabel")({ Text = "ready", Parent = ParentSource })
	end)
	local Connection = SecondContainer.ChildAdded:Connect(function()
		Owner:Destroy()
	end)
	ParentSource:Set(SecondContainer)
	Interfacer.Flush()
	task.wait()
	local Detached = Target.Parent == nil
	Connection:Disconnect()
	FirstContainer:Destroy()
	SecondContainer:Destroy()
	ParentSource:Destroy()
	Assertions(Detached, "reactive Parent uses the same destruction lease as literal Parent")
end)

Assertions.rtest("native lifecycle · repeated remount keeps the model usable", function()
	local Source = Interfacer.State("first")
	local Container = Instance.new("Folder")
	for Index = 1, 12 do
		local Label : TextLabel
		local Owner = Interfacer.Scope(function()
			Label = Interfacer.New("TextLabel")({ Text = Source, Parent = Container })
		end)
		Source:Set(tostring(Index))
		Interfacer.Flush()
		Assertions(Label.Text == tostring(Index), "remounted target receives its model value")
		Owner:Destroy()
	end
	task.wait()
	Assertions(#Container:GetChildren() == 0, "all remounted roots were released")
	Assertions(Source:Get() == "12", "live model remains readable")
	Source:Destroy()
	Container:Destroy()
end)

Assertions.rtest("native lifecycle · disposal while reactive children attach detaches external children", function()
	local Container = Instance.new("Folder")
	local Child = Instance.new("Folder")
	local Source = Interfacer.State({ Child })
	local Owner = Interfacer.Scope(function() end)
	local Connection = Container.ChildAdded:Connect(function()
		Owner:Destroy()
	end)
	Interfacer.WithOwner(Owner, function()
		Interfacer.Edit(Container)({ Source })
	end)
	task.wait()
	local Detached = Child.Parent == nil
	Connection:Disconnect()
	Child:Destroy()
	Container:Destroy()
	Source:Destroy()
	Assertions(Detached, "revoked child attachment cannot survive its active Parent write")
end)

Assertions.rtest("native lifecycle · disposed two-way initialization cannot install a late listener", function()
	local Label = Instance.new("TextLabel")
	local Source = Interfacer.State("first")
	local Owner = Interfacer.Scope(function() end)
	local Connection = Label:GetPropertyChangedSignal("Text"):Connect(function()
		Owner:Destroy()
	end)
	Interfacer.WithOwner(Owner, function()
		Interfacer.Edit(Label)({ Text = Interfacer.Model(Source) })
	end)
	task.wait()
	Connection:Disconnect()
	Label.Text = "stale"
	task.wait()
	local Actual = Source:Get()
	Label:Destroy()
	Source:Destroy()
	Assertions(Actual == "first", "a disposed owner cannot gain a two-way listener after its initial callback")
end)

Assertions.rtest("native lifecycle · event callbacks disconnect on scope disposal", function()
	local Event : BindableEvent
	local Calls = 0
	local Owner = Interfacer.Scope(function()
		Event = Interfacer.New("BindableEvent")({ Event = function()
			Calls += 1
		end })
	end)
	Event:Fire()
	task.wait()
	Owner:Destroy()
	Event:Fire()
	task.wait()
	Assertions(Calls == 1, "stale callbacks never run after their owner is disposed")
end)

Assertions.rtest("native lifecycle · child cleanup revokes before reentrant source writes", function()
	local Container = Instance.new("Folder")
	local First = Instance.new("Folder")
	local Second = Instance.new("Folder")
	local Source = Interfacer.State({ First })
	local Owner = Interfacer.Scope(function()
		Interfacer.Edit(Container)({ Source })
	end)
	Interfacer.Flush()
	local Connection = Container.ChildRemoved:Connect(function()
		Source:Set({ Second })
		Interfacer.Flush()
	end)
	Owner:Destroy()
	task.wait()
	local Detached = First.Parent == nil and Second.Parent == nil
	Connection:Disconnect()
	Container:Destroy()
	First:Destroy()
	Second:Destroy()
	Source:Destroy()
	Assertions(Detached, "reentrant cleanup cannot resurrect a child registration")
end)

Assertions.rtest("native lifecycle · equality callback disposal cancels a late two-way listener", function()
	local Label = Instance.new("TextLabel")
	local Owner = Interfacer.Scope(function() end)
	local Comparisons = 0
	local Source = Interfacer.State("initial", function(First : string, Second : string)
		Comparisons += 1
		Owner:Destroy()
		return First == Second
	end)
	Interfacer.WithOwner(Owner, function()
		Interfacer.Edit(Label)({ Text = Interfacer.Model(Source) })
	end)
	local Before = Comparisons
	Label.Text = "stale"
	task.wait()
	local Actual = Source:Get()
	Label:Destroy()
	Source:Destroy()
	Assertions(Before > 0 and Comparisons == Before and Actual == "initial", "listener returned after cancellation must disconnect immediately")
end)

Assertions.rtest("native lifecycle · replacing a two-way binding revokes its reverse listener", function()
	local First = Interfacer.State("first")
	local Second = Interfacer.State("second")
	local Label = Instance.new("TextLabel")
	local Owner = Interfacer.Scope(function()
		Interfacer.Edit(Label)({ Text = Interfacer.Model(First) })
		Interfacer.Edit(Label)({ Text = Interfacer.Model(Second) })
	end)
	Label.Text = "edited"
	task.wait()
	local OldValue, NewValue = First:Get(), Second:Get()
	Owner:Destroy()
	Label:Destroy()
	First:Destroy()
	Second:Destroy()
	Assertions(OldValue == "first" and NewValue == "edited", "only the replacement model receives user edits")
end)

return true
